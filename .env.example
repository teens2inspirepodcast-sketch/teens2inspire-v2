# Public values (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=

# Server-only Supabase key. Use the current secret key, or the legacy service-role key if needed.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only Stripe credentials. No Stripe publishable key is used: Checkout and Billing Portal
# are hosted by Stripe and opened using server-created session URLs.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Server-only Cloudflare R2 S3 API credentials and bucket names.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_BUCKET_NAME=

# Public HTTPS custom domain attached to the artwork bucket (not a secret).
R2_PUBLIC_BASE_URL=

# For local development, set this to http://localhost:3000 in .env.local.
# For production, set the real public HTTPS origin (for example, https://www.example.com).
